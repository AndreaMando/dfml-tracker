# Copy to .env.local and fill in. See README.md > Environment variables.

POSTGRES_URL=

# leghe.fantacalcio.it session tokens (App_Key + auth token) are no longer
# env vars — they expire and need updating without a redeploy, so they live
# in the DB instead, editable from the protected /settings page. Set them
# once there after first deploy.

# Competition IDs are no longer env vars either — set per season in the
# "Create Season" form (Campionato / Coppa fields), saved on the season row.

# Protects the /settings page (App_Key/auth token editor) behind a password
# modal. Pick a long random passphrase, not a short PIN.
SETTINGS_PASSWORD=
# Random secret used to sign the settings-page session cookie. Generate once
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETTINGS_SESSION_SECRET=
